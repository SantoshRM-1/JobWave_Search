# ==========================================
# Backend Environment Variables (Railway)
# ==========================================

# Groq API Key (Required for multi-agent reasoning & resume extraction)
GROQ_API_KEY=your_groq_api_key_here

# SerpApi Key (Optional fallback for Google Jobs search)
SERP_API_KEY=your_serp_api_key_here

# RapidAPI Key (Optional for JSearch job provider)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API Key (Optional fallback if configured)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (Optional - defaults to sqlite:///./sqlite.db)
DATABASE_URL=sqlite:///./sqlite.db

# Allowed CORS Origins (Comma-separated or *)
CORS_ORIGINS=*

# Server Port (Injected automatically by Railway)
PORT=8000
