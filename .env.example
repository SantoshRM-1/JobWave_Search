# ==========================================
# JobWave Search - Environment Variables
# ==========================================

# ------------------------------------------
# Backend Environment Variables (Railway)
# ------------------------------------------

# Groq API Key (Required for LLM multi-agent reasoning & extraction)
GROQ_API_KEY=your_groq_api_key_here

# SerpApi Key (Optional fallback for Google Jobs search)
SERP_API_KEY=your_serp_api_key_here

# RapidAPI Key (Optional for JSearch job listings)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API Key (Optional fallback if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (Optional - defaults to sqlite:///./sqlite.db, or sqlite:////data/sqlite.db on Railway persistent volumes)
DATABASE_URL=sqlite:///./sqlite.db

# Frontend Domain URL (For CORS whitelist)
FRONTEND_URL=https://jobwave-search.vercel.app

# CORS Allowed Origins (Comma-separated list or *)
CORS_ORIGINS=https://jobwave-search.vercel.app,http://localhost:5173

# Port (Injected automatically by Railway, defaults to 8000)
PORT=8000


# ------------------------------------------
# Frontend Environment Variables (Vercel)
# ------------------------------------------

# Backend API URL (Set in Vercel project environment variables to your deployed Railway backend URL)
VITE_API_URL=https://your-railway-app.up.railway.app
VITE_API_BASE=https://your-railway-app.up.railway.app
